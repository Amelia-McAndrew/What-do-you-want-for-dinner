rules_version = '2';

// Security rules for household sharing. Paste these into
// Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // A household can be opened or created by its code, but households can't be listed,
    // so the only way in is knowing the code.
    match /households/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && code.size() >= 16;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && collection in ['places', 'items', 'recipes', 'plan']
          && exists(/databases/$(database)/documents/households/$(code));
      }
    }
  }
}
